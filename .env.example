# Form endpoint (optional). If empty, form uses FormSubmit → mn@realconstruction.kz
# PUBLIC_FORMSPREE_ID=your-form-id

# Optional analytics
# PUBLIC_GA_ID=G-XXXXXXXX
# PUBLIC_YANDEX_METRIKA_ID=00000000

# Vercel Blob store token (Vercel dashboard → Storage → Blob → .env.local tab).
# Required for the image migration script and for /admin/upload in local dev.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Shared password checked by /admin/upload before issuing a Blob upload token.
# Set the same value in Vercel project settings → Environment Variables.
# ADMIN_UPLOAD_SECRET=choose-a-long-random-string
