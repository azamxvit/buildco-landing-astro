---
import T from "./T.astro";

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  class?: string;
}

const { eyebrow, title, subtitle, class: className = "" } = Astro.props;
---

<header class:list={["mb-12 max-w-xl reveal", className]}>
  <p class="eyebrow mb-4 inline-flex items-center gap-2">
    <span class="inline-block h-0.5 w-6 bg-accent" aria-hidden="true"></span>
    <T path={eyebrow} />
  </p>
  <h2 class="display-title mb-3">
    <T path={title} />
  </h2>
  {
    subtitle && (
      <p class="text-base leading-relaxed text-soft">
        <T path={subtitle} />
      </p>
    )
  }
</header>
