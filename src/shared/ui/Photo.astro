---
import { Image } from "astro:assets";
import { resolveImage } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  format?: "webp" | "avif";
  quality?: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  width?: number;
  height?: number;
  class?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  widths,
  sizes,
  format = "webp",
  quality = 70,
  loading = "lazy",
  class: className,
  ...rest
} = Astro.props;

const asset = resolveImage(src);
const scaledWidths = asset && widths ? widths.filter((width) => width <= asset.width) : widths;
---

{
  asset ? (
    <Image
      src={asset}
      alt={alt}
      widths={scaledWidths && scaledWidths.length > 0 ? scaledWidths : undefined}
      sizes={sizes}
      format={format}
      quality={quality}
      loading={loading}
      class={className}
      {...rest}
    />
  ) : (
    <img src={src} alt={alt} loading={loading} decoding="async" class={className} {...rest} />
  )
}
