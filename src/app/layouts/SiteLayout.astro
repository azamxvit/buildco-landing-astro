---
import Header from "../../widgets/Header/Header.astro";
import Footer from "../../widgets/Footer/Footer.astro";
import FloatingContact from "../../widgets/FloatingContact/FloatingContact.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  flush?: boolean;
  path?: string;
  ogImage?: string;
}

const { title, description, flush = false, path = Astro.url.pathname, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} path={path} ogImage={ogImage}>
  <Header />
  <main class:list={[!flush && "pt-[var(--spacing-header)]"]}>
    <slot />
  </main>
  <Footer />
  <FloatingContact />
</BaseLayout>
