---
import "../styles/globals.css";
import { getMessages } from "../../messages";
import { site } from "../../shared/config/site";

interface Props {
  title?: string;
  description?: string;
}

const messages = getMessages("ru");
const { title = messages.meta.title, description = messages.meta.description } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.brand,
  legalName: "ТОО «REAL CONSTRUCTION CO»",
  url: site.siteUrl,
  telephone: site.contact.phone,
  email: site.contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "улица Байтурсынова 47А, офис 207",
    addressLocality: "Атырау",
    addressCountry: "KZ",
  },
  areaServed: "Atyrau, Kazakhstan",
};
---

<!doctype html>
<html lang="ru" data-locale="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#005db7" />
    <link rel="canonical" href={site.siteUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/bebas-neue-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-cyrillic-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {
      import.meta.env.PUBLIC_GA_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${import.meta.env.PUBLIC_GA_ID}');`}
          />
        </>
      )
    }
    {
      import.meta.env.PUBLIC_YANDEX_METRIKA_ID && (
        <script
          is:inline
          set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(${import.meta.env.PUBLIC_YANDEX_METRIKA_ID},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true});`}
        />
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import { initRevealAnimations } from "../../shared/lib/animate";
      initRevealAnimations();
    </script>
  </body>
</html>
