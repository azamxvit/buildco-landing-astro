---
import "../styles/globals.css";
import { getMessages } from "../../messages";
import { site } from "../../shared/config/site";

interface Props {
  title?: string;
  description?: string;
  /** Path for canonical URL, e.g. `/about` or `` for home */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
}

const messages = getMessages("ru");
const {
  title = messages.meta.title,
  description = messages.meta.description,
  path = "",
  ogImage = "https://1gsfckjyk1ky44yh.public.blob.vercel-storage.com/images/og-default.jpg",
  noindex = false,
} = Astro.props;

const canonicalPath = path === "/" ? "" : path.replace(/\/$/, "");
const canonicalUrl = `${site.siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${site.siteUrl}${ogImage}`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.siteUrl}/#organization`,
      name: site.brand,
      legalName: "ТОО «REAL CONSTRUCTION CO»",
      url: site.siteUrl,
      logo: `${site.siteUrl}/images/rcc-logo.svg`,
      email: site.contact.email,
      telephone: site.contact.phone,
      address: {
        "@type": "PostalAddress",
        streetAddress: "улица Байтурсынова 47А, офис 207",
        addressLocality: "Атырау",
        addressRegion: "Атырауская область",
        addressCountry: "KZ",
      },
      sameAs: [],
    },
    {
      "@type": "ConstructionBusiness",
      "@id": `${site.siteUrl}/#localbusiness`,
      name: site.brand,
      legalName: "ТОО «REAL CONSTRUCTION CO»",
      url: site.siteUrl,
      image: ogImageUrl,
      telephone: site.contact.phone,
      email: site.contact.email,
      priceRange: "$$",
      address: {
        "@type": "PostalAddress",
        streetAddress: "улица Байтурсынова 47А, офис 207",
        addressLocality: "Атырау",
        addressRegion: "Атырауская область",
        postalCode: "060011",
        addressCountry: "KZ",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 47.10274,
        longitude: 51.90672,
      },
      areaServed: [
        { "@type": "City", name: "Atyrau" },
        { "@type": "Country", name: "Kazakhstan" },
      ],
      parentOrganization: { "@id": `${site.siteUrl}/#organization` },
    },
    {
      "@type": "WebSite",
      "@id": `${site.siteUrl}/#website`,
      url: site.siteUrl,
      name: site.brand,
      description: messages.meta.description,
      publisher: { "@id": `${site.siteUrl}/#organization` },
      inLanguage: ["ru", "en", "kk"],
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": `${site.siteUrl}/#website` },
      about: { "@id": `${site.siteUrl}/#localbusiness` },
      inLanguage: "ru",
    },
  ],
};
---

<!doctype html>
<html lang="ru" data-locale="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={messages.meta.keywords} />
    <meta name="author" content={site.brand} />
    <meta name="theme-color" content="#005db7" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="ru_KZ" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="kk_KZ" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={messages.meta.ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {
      import.meta.env.PUBLIC_GA_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${import.meta.env.PUBLIC_GA_ID}');`}
          />
        </>
      )
    }
    {
      import.meta.env.PUBLIC_YANDEX_METRIKA_ID && (
        <script
          is:inline
          set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return}}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');ym(${import.meta.env.PUBLIC_YANDEX_METRIKA_ID},'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true});`}
        />
      )
    }
  </head>
  <body>
    <slot />
    <script>
      import { initRevealAnimations } from "../../shared/lib/animate";
      initRevealAnimations();
    </script>
  </body>
</html>
