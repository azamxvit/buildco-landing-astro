---
import SiteLayout from "../app/layouts/SiteLayout.astro";
import Hero from "../widgets/Hero/Hero.astro";
import About from "../widgets/About/About.astro";
import Services from "../widgets/Services/Services.astro";
import Projects from "../widgets/Projects/Projects.astro";
import Clients from "../widgets/Clients/Clients.astro";
import Certifications from "../widgets/Certifications/Certifications.astro";
import CTA from "../widgets/CTA/CTA.astro";
import Contact from "../widgets/Contact/Contact.astro";
import { getMessages } from "../messages";
import { getServices, getProjects, getPartners, getCertificates } from "../shared/api/content";

const meta = getMessages("ru").meta;
const [services, projects, partners, certifications] = await Promise.all([
  getServices("ru"),
  getProjects("ru"),
  getPartners(),
  getCertificates("ru"),
]);
---

<SiteLayout title={meta.title} description={meta.description} flush>
  <Hero />
  <About showMoreLink />
  <Services limit={6} services={services} />
  <Projects limit={6} projects={projects} />
  <Clients withLogosOnly clients={partners} />
  <Certifications certifications={certifications} />
  <CTA />
  <Contact />
</SiteLayout>
