---
import SiteLayout from "../../app/layouts/SiteLayout.astro";
import Services from "../../widgets/Services/Services.astro";
import { getMessages } from "../../messages";
import { getServices } from "../../shared/api/strapi";

const page = getMessages("ru").pages.services;
const services = await getServices("ru");
---

<SiteLayout title={page.title} description={page.description}>
  <Services tone="accent" services={services} />
</SiteLayout>
