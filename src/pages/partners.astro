---
import SiteLayout from "../app/layouts/SiteLayout.astro";
import Clients from "../widgets/Clients/Clients.astro";
import { getMessages } from "../messages";
import { getPartners } from "../shared/api/strapi";

const page = getMessages("ru").pages.partners;
const clients = await getPartners();
---

<SiteLayout title={page.title} description={page.description}>
  <Clients clients={clients} />
</SiteLayout>
