---
import SectionTitle from "../../shared/ui/SectionTitle.astro";
import ServiceIcon from "../../shared/ui/ServiceIcon.astro";
import T from "../../shared/ui/T.astro";
import Button from "../../shared/ui/Button.astro";
import { site, type ServiceItem } from "../../shared/config/site";

interface Props {
  limit?: number;
  services?: ServiceItem[];
}

const { limit, services: servicesProp } = Astro.props;
const source = servicesProp ?? site.services;
const items = limit ? source.slice(0, limit) : source;
---

<section
  class="theme theme--band relative overflow-hidden bg-bg py-[var(--spacing-section)]"
  id="services"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-10 [background-image:repeating-linear-gradient(45deg,#000_0,#000_2px,transparent_2px,transparent_14px)]"
    aria-hidden="true"
  >
  </div>

  <div class="page-container relative">
    <SectionTitle eyebrow="services.eyebrow" title="services.title" subtitle="services.subtitle" />

    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        items.map((service, index) => (
          <a
            href={`/services/${service.slug}`}
            class:list={[
              "theme theme--panel reveal group flex h-full flex-col gap-4 border border-border bg-surface p-6 transition duration-300 hover:-translate-y-1 hover:border-accent hover:bg-surface-hover hover:shadow-[0_16px_40px_rgb(0_0_0_/_0.4)]",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
          >
            <div class="flex h-12 w-12 items-center justify-center border border-border-strong bg-accent-dim text-accent transition group-hover:border-accent">
              <ServiceIcon name={service.icon} />
            </div>
            <h3 class="font-display text-[clamp(1.15rem,2vw,1.6rem)] uppercase leading-[1.1] tracking-[0.02em] text-fg break-words sm:min-h-[5.25rem]">
              <T path={`services.items.${service.id}.title`} />
            </h3>
            <p class="text-sm leading-relaxed text-muted">
              <T path={`services.items.${service.id}.description`} />
            </p>
            <span class="mt-auto text-xs font-semibold uppercase tracking-[0.14em] text-accent">
              <T path="cta.more" /> →
            </span>
          </a>
        ))
      }
    </div>

    {
      limit && (
        <div class="mt-10 flex justify-center">
          <Button href="/services" variant="outline">
            <T path="cta.allServices" />
          </Button>
        </div>
      )
    }
  </div>
</section>
