---
import T from "../../shared/ui/T.astro";
import { site } from "../../shared/config/site";

const year = new Date().getFullYear();
const { developer } = site;
const CreditTag = developer.url ? "a" : "div";
const creditAttrs = developer.url
  ? {
      href: developer.url,
      target: "_blank",
      rel: "noopener noreferrer",
    }
  : {};
---

<footer class="theme theme--elevated border-t border-border bg-bg" role="contentinfo">
  <div class="page-container flex flex-col gap-8 py-12 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-2">
      <img
        src="/images/rcc-logo.svg"
        alt=""
        width="140"
        height="50"
        class="h-9 w-auto object-contain object-left sm:h-10"
        aria-hidden="true"
      />
      <p class="font-display text-[clamp(1.25rem,2.2vw,1.75rem)] uppercase tracking-[0.05em] text-accent">
        {site.brand}
      </p>
      <p class="text-sm text-muted">
        <T path="footer.tagline" />
      </p>
      <p class="text-sm text-muted">
        © {year} <T path="brand.legal" />. <T path="footer.rights" />
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
      {
        site.nav.map((item) => (
          <a href={item.href} class="text-sm text-muted transition hover:text-accent">
            <T path={`nav.${item.key}`} />
          </a>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-border/80">
    <div class="page-container py-5">
      <CreditTag
        class="sss-credit group relative flex flex-col gap-4 overflow-hidden pl-4 sm:flex-row sm:items-center sm:gap-5"
        {...creditAttrs}
      >
        <span
          class="pointer-events-none absolute inset-y-1 left-0 w-0.5 rounded-full bg-sss/80"
          aria-hidden="true"
        ></span>

        <div class="relative flex shrink-0 items-center justify-center">
          <img
            src={developer.logo}
            alt={developer.name}
            width="88"
            height="110"
            class="relative h-[5.5rem] w-auto object-contain sm:h-28"
            loading="lazy"
          />
        </div>

        <div class="relative min-w-0 flex-1">
          <p class="eyebrow text-sss">
            <T path="footer.madeBy" />
          </p>
          <p class="mt-1 font-display text-[clamp(1.15rem,2vw,1.45rem)] uppercase tracking-[0.06em] text-fg">
            {developer.name}
          </p>
          <p class="mt-1 text-sm leading-snug text-muted">
            <T path="footer.developerTagline" />
          </p>
          {
            developer.phone && developer.phoneHref && (
              <p class="mt-2 text-sm text-muted">
                <T path="footer.developerContact" />
                {": "}
                <a
                  href={developer.phoneHref}
                  class="font-semibold text-sss transition hover:underline"
                >
                  {developer.phone}
                </a>
              </p>
            )
          }
          <p class="mt-2 font-mono text-[0.6875rem] tracking-wide text-muted/80">
            {developer.legal} · <T path="footer.bin" /> {developer.bin}
          </p>
        </div>

        {
          developer.url && (
            <span
              class="relative hidden text-sss transition duration-300 group-hover:translate-x-0.5 sm:inline-flex"
              aria-hidden="true"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          )
        }
      </CreditTag>
    </div>
  </div>
</footer>
