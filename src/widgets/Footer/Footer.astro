---
import T from "../../shared/ui/T.astro";
import { site } from "../../shared/config/site";

const year = new Date().getFullYear();
---

<footer class="theme theme--elevated border-t border-border bg-bg py-12" role="contentinfo">
  <div class="mx-auto flex w-[min(100%-2.5rem,var(--container-max))] flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div class="flex flex-col gap-2">
      <p class="font-display text-[clamp(1.25rem,2.2vw,1.75rem)] uppercase tracking-[0.05em] text-accent">
        {site.brand}
      </p>
      <p class="text-sm text-muted">
        <T path="footer.tagline" />
      </p>
      <p class="text-sm text-muted">
        © {year} <T path="brand.legal" />. <T path="footer.rights" />
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
      {
        site.nav.map((item) => (
          <a href={item.href} class="text-sm text-muted transition hover:text-accent">
            <T path={`nav.${item.key}`} />
          </a>
        ))
      }
    </nav>
  </div>
</footer>
