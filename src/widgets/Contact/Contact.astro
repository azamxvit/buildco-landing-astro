---
import SectionTitle from "../../shared/ui/SectionTitle.astro";
import Button from "../../shared/ui/Button.astro";
import T from "../../shared/ui/T.astro";
import { site } from "../../shared/config/site";
import { messages } from "../../messages";

interface Props {
  showMap?: boolean;
}

const { showMap = false } = Astro.props;
---

<section class="theme theme--elevated bg-bg py-[var(--spacing-section)]" id="contact">
  <div class="page-container">
    <SectionTitle
      eyebrow="contact.eyebrow"
      title="contact.title"
      subtitle="contact.subtitle"
    />

    <div class="grid gap-10 lg:grid-cols-2">
      <div class="reveal flex flex-col gap-6">
        <div class="border-b border-border pb-4">
          <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
            <T path="contact.labels.phone" />
          </p>
          <a class="text-lg font-medium transition hover:text-accent" href={site.contact.phoneHref}>
            {site.contact.phone}
          </a>
        </div>
        <div class="border-b border-border pb-4">
          <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
            <T path="contact.labels.email" />
          </p>
          <a class="block text-lg font-medium transition hover:text-accent" href={`mailto:${site.contact.email}`}>
            {site.contact.email}
          </a>
        </div>
        <div class="border-b border-border pb-4">
          <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
            <T path="contact.labels.address" />
          </p>
          <address class="text-lg font-medium not-italic">
            <a
              href={site.contact.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-accent"
            >
              <span data-i18n="ru">{site.contact.addressRu}</span>
              <span data-i18n="en">{site.contact.addressEn}</span>
              <span data-i18n="kz">{site.contact.addressKz}</span>
            </a>
          </address>
        </div>

        {
          showMap && (
            <div class="reveal mt-2">
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
                <T path="contact.mapTitle" />
              </p>
              <div class="overflow-hidden border border-border bg-surface">
                <iframe
                  title="Map"
                  src={site.contact.mapEmbedUrl}
                  class="h-[min(24rem,50vh)] min-h-80 w-full"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                />
              </div>
              <p class="mt-2 text-sm text-muted">
                <a
                  class="text-accent transition hover:underline"
                  href={site.contact.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  2GIS →
                </a>
              </p>
            </div>
          )
        }
      </div>

      <form
        class="reveal reveal-delay-2 flex flex-col gap-4 border border-border bg-surface p-6 md:p-8"
        action={site.formEndpoint}
        method="POST"
        id="contact-form"
        data-success-ru={messages.ru.contact.form.success}
        data-success-en={messages.en.contact.form.success}
        data-success-kz={messages.kz.contact.form.success}
        data-success-title-ru={messages.ru.contact.form.successTitle}
        data-success-title-en={messages.en.contact.form.successTitle}
        data-success-title-kz={messages.kz.contact.form.successTitle}
        data-error-ru={messages.ru.contact.form.error}
        data-error-en={messages.en.contact.form.error}
        data-error-kz={messages.kz.contact.form.error}
        data-error-title-ru={messages.ru.contact.form.errorTitle}
        data-error-title-en={messages.en.contact.form.errorTitle}
        data-error-title-kz={messages.kz.contact.form.errorTitle}
        data-network-ru={messages.ru.contact.form.network}
        data-network-en={messages.en.contact.form.network}
        data-network-kz={messages.kz.contact.form.network}
        data-sending-ru={messages.ru.contact.form.sending}
        data-sending-en={messages.en.contact.form.sending}
        data-sending-kz={messages.kz.contact.form.sending}
      >
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="Заявка с сайта REAL CONSTRUCTION CO" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_replyto" id="contact-replyto" value="" />
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold uppercase tracking-[0.1em] text-muted" for="name">
            <T path="contact.form.name" />
          </label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full border border-border-strong bg-bg px-4 py-3 text-fg outline-none transition focus:border-accent focus:shadow-[0_0_0_0.2rem_var(--color-accent-dim)]"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold uppercase tracking-[0.1em] text-muted" for="phone">
            <T path="contact.form.phone" />
          </label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            class="w-full border border-border-strong bg-bg px-4 py-3 text-fg outline-none transition focus:border-accent focus:shadow-[0_0_0_0.2rem_var(--color-accent-dim)]"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold uppercase tracking-[0.1em] text-muted" for="email">
            <T path="contact.form.email" />
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full border border-border-strong bg-bg px-4 py-3 text-fg outline-none transition focus:border-accent focus:shadow-[0_0_0_0.2rem_var(--color-accent-dim)]"
          />
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs font-semibold uppercase tracking-[0.1em] text-muted" for="message">
            <T path="contact.form.message" />
          </label>
          <textarea
            id="message"
            name="message"
            required
            class="min-h-32 w-full resize-y border border-border-strong bg-bg px-4 py-3 text-fg outline-none transition focus:border-accent focus:shadow-[0_0_0_0.2rem_var(--color-accent-dim)]"
          ></textarea>
        </div>
        <label class="flex items-start gap-3 text-sm text-muted">
          <input type="checkbox" name="consent" required class="mt-1 accent-[var(--color-accent)]" />
          <span><T path="contact.form.consent" /></span>
        </label>
        <Button type="submit" variant="primary" class="w-full" id="contact-submit">
          <T path="cta.submit" />
        </Button>
        <div
          id="form-status"
          class="hidden border px-4 py-3.5 data-[state=error]:border-[#8a3a3a]/70 data-[state=error]:bg-[rgb(138_58_58_/_0.14)] data-[state=network]:border-[#8a3a3a]/70 data-[state=network]:bg-[rgb(138_58_58_/_0.14)] data-[state=sending]:border-border-strong data-[state=sending]:bg-bg data-[state=success]:border-accent/45 data-[state=success]:bg-accent-dim"
          role="status"
          aria-live="polite"
          data-state=""
          hidden
        >
          <div class="flex items-start gap-3">
            <span
              id="form-status-icon"
              class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center border border-current/25 bg-bg/40 text-accent data-[state=error]:text-[#e08a8a] data-[state=network]:text-[#e08a8a] data-[state=sending]:text-muted"
              aria-hidden="true"
            ></span>
            <div class="min-w-0 flex-1 pt-0.5">
              <p
                id="form-status-title"
                class="mb-1 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent data-[state=error]:text-[#e08a8a] data-[state=network]:text-[#e08a8a] data-[state=sending]:text-muted"
              ></p>
              <p id="form-status-text" class="text-sm leading-relaxed text-soft"></p>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const statusTitle = document.getElementById("form-status-title");
  const statusText = document.getElementById("form-status-text");
  const statusIcon = document.getElementById("form-status-icon");
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;

  type StatusState = "success" | "error" | "network" | "sending";

  const icons: Record<StatusState, string> = {
    sending:
      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8" stroke-linecap="round"/></svg>',
    success:
      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    error:
      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01" stroke-linecap="round"/></svg>',
    network:
      '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01" stroke-linecap="round"/></svg>',
  };

  const pick = (key: string, locale: string) => {
    const byLocale: Record<string, string | undefined> = {
      ru: form?.dataset[`${key}Ru`],
      en: form?.dataset[`${key}En`],
      kz: form?.dataset[`${key}Kz`],
    };
    return byLocale[locale] ?? byLocale.ru ?? "";
  };

  const setStatus = (state: StatusState, locale: string) => {
    if (!status || !statusText || !statusTitle || !statusIcon) return;

    status.hidden = false;
    status.classList.remove("hidden");
    status.dataset.state = state;
    statusTitle.dataset.state = state;
    statusIcon.dataset.state = state;
    statusIcon.innerHTML = icons[state];

    if (state === "success") {
      statusTitle.hidden = false;
      statusTitle.textContent = pick("successTitle", locale);
      statusText.textContent = pick("success", locale);
      return;
    }

    if (state === "error") {
      statusTitle.hidden = false;
      statusTitle.textContent = pick("errorTitle", locale);
      statusText.textContent = pick("error", locale);
      return;
    }

    statusTitle.hidden = true;
    statusTitle.textContent = "";
    statusText.textContent = pick(state, locale);
  };

  const isSuccessPayload = (payload: unknown, responseOk: boolean) => {
    if (payload && typeof payload === "object") {
      const data = payload as { success?: unknown; ok?: unknown; error?: unknown; message?: unknown };
      const message = String(data.message ?? "").toLowerCase();
      if (
        message.includes("confirm") ||
        message.includes("activate") ||
        message.includes("activation") ||
        message.includes("check your email")
      ) {
        return true;
      }
      if ("success" in data) {
        return data.success === true || data.success === "true";
      }
      if ("ok" in data) {
        return data.ok === true || data.ok === "true";
      }
      if (data.error) return false;
    }
    return responseOk;
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form) return;

    const honeypot = (form.elements.namedItem("_honey") as HTMLInputElement | null)?.value;
    if (honeypot) return;

    const locale = document.documentElement.dataset.locale ?? "ru";
    const emailInput = form.elements.namedItem("email") as HTMLInputElement | null;
    const replyTo = form.elements.namedItem("_replyto") as HTMLInputElement | null;
    if (replyTo && emailInput) replyTo.value = emailInput.value;

    const data = new FormData(form);
    const payloadBody = Object.fromEntries(data.entries());

    if (submitBtn) submitBtn.disabled = true;
    setStatus("sending", locale);

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: JSON.stringify(payloadBody),
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
      });

      const payload = await response.json().catch(() => null);

      if (isSuccessPayload(payload, response.ok)) {
        form.reset();
        setStatus("success", locale);
      } else {
        setStatus("error", locale);
      }
    } catch {
      setStatus("network", locale);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
