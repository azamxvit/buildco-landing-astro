---
import SectionTitle from "../../shared/ui/SectionTitle.astro";
import { site, type ClientItem } from "../../shared/config/site";

interface Props {
  limit?: number;
  clients?: ClientItem[];
}

const { limit, clients: clientsProp } = Astro.props;
const source = clientsProp ?? site.clients;
const clients = limit ? source.slice(0, limit) : source;
---

<section class="theme theme--elevated bg-bg py-[clamp(3rem,7vw,5rem)]" id="clients">
  <div class="page-container">
    <SectionTitle
      eyebrow="clients.eyebrow"
      title="clients.title"
      subtitle="clients.subtitle"
    />

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
      {
        clients.map((client, index) => (
          <article
            class:list={[
              "reveal group flex min-h-[7.5rem] flex-col items-center justify-center gap-3 border border-border bg-bg px-5 py-7 transition duration-300 hover:border-accent/60 hover:bg-surface",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
          >
            {
              client.logo ? (
                <div class="flex h-14 w-full items-center justify-center">
                  <img
                    src={client.logo}
                    alt={client.label}
                    width="240"
                    height="56"
                    loading="lazy"
                    class="max-h-14 w-auto max-w-[88%] object-contain opacity-80 transition duration-300 group-hover:opacity-100"
                  />
                </div>
              ) : (
                <span class="font-display text-center text-xl tracking-[0.12em] text-accent">{client.label}</span>
              )
            }
            <p class="text-center text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-muted">
              {client.label}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
