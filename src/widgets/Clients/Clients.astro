---
import SectionTitle from "../../shared/ui/SectionTitle.astro";
import { site } from "../../shared/config/site";
---

<section class="py-[clamp(3rem,7vw,5rem)]" id="clients">
  <div class="mx-auto w-[min(100%-2.5rem,var(--container-max))]">
    <SectionTitle
      eyebrow="clients.eyebrow"
      title="clients.title"
      subtitle="clients.subtitle"
    />

    <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
      {
        site.clients.map((client, index) => (
          <article
            class:list={[
              "reveal flex min-h-28 flex-col items-center justify-center gap-2 border border-border bg-bg-elevated px-4 py-6 text-center opacity-70 grayscale transition duration-300 hover:border-accent hover:bg-surface hover:opacity-100 hover:grayscale-0",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
          >
            <span class="font-display text-[1.75rem] tracking-[0.12em] text-accent">{client.shortName}</span>
            <span class="text-sm text-soft">{client.name}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>
