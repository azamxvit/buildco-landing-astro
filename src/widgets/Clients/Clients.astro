---
import SectionTitle from "../../shared/ui/SectionTitle.astro";
import { site } from "../../shared/config/site";
---

<section class="bg-bg-elevated py-[clamp(3rem,7vw,5rem)]" id="clients">
  <div class="mx-auto w-[min(100%-2.5rem,var(--container-max))]">
    <SectionTitle
      eyebrow="clients.eyebrow"
      title="clients.title"
      subtitle="clients.subtitle"
    />

    <div class="grid grid-cols-2 gap-5 md:grid-cols-3 lg:grid-cols-5">
      {
        site.clients.map((client, index) => (
          <article
            class:list={[
              "reveal group flex min-h-40 flex-col items-center justify-center gap-4 border border-border bg-bg-elevated px-4 py-8 transition duration-300 hover:border-accent hover:bg-surface",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
          >
            <img
              src={client.logo}
              alt={client.name}
              width="280"
              height="140"
              loading="lazy"
              class="h-24 w-auto max-w-[90%] object-contain opacity-100 transition duration-300 md:h-28 lg:opacity-70 lg:grayscale lg:group-hover:opacity-100 lg:group-hover:grayscale-0"
            />
            <p class="text-center text-xs leading-snug text-muted">{client.name}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
