---
import SectionTitle from "../../shared/ui/SectionTitle.astro";
import { site, type ClientItem } from "../../shared/config/site";

interface Props {
  withLogosOnly?: boolean;
  limit?: number;
  clients?: ClientItem[];
}

const { withLogosOnly = false, limit, clients: clientsProp } = Astro.props;
const source = clientsProp ?? site.clients;
let clients = withLogosOnly ? source.filter((c) => c.logo) : source;
if (limit) clients = clients.slice(0, limit);
---

<section class="theme theme--elevated bg-bg py-[clamp(3rem,7vw,5rem)]" id="clients">
  <div class="page-container">
    <SectionTitle
      eyebrow="clients.eyebrow"
      title="clients.title"
      subtitle="clients.subtitle"
    />

    <div class="grid grid-cols-2 gap-5 md:grid-cols-3 lg:grid-cols-4">
      {
        clients.map((client, index) => (
          <article
            class:list={[
              "reveal group flex min-h-36 flex-col items-center justify-center gap-4 border border-border bg-bg px-4 py-8 transition duration-300 hover:border-accent hover:bg-surface",
              `reveal-delay-${(index % 3) + 1}`,
            ]}
          >
            {
              client.logo ? (
                <img
                  src={client.logo}
                  alt={client.name}
                  width="280"
                  height="140"
                  loading="lazy"
                  class="h-20 w-auto max-w-[90%] object-contain opacity-100 transition duration-300 md:h-24 lg:opacity-70 lg:grayscale lg:group-hover:opacity-100 lg:group-hover:grayscale-0"
                />
              ) : (
                <span class="font-display text-center text-2xl tracking-wide text-accent">{client.name.split("«")[1]?.replace("»", "") ?? client.name}</span>
              )
            }
            <p class="text-center text-xs leading-snug text-muted">{client.name}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
